# ============================================================
# ЗАЩИТА САЙТА (Apache). Файл лежит в той же папке, что и index.html
# ============================================================

# --- 1. Принудительный HTTPS: все запросы по http перенаправляем на https ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# --- 2. Заголовки безопасности для всех ответов ---
<IfModule mod_headers.c>
  # CSP: скрипты/фреймы только Яндекс Форм + собственные файлы; запрет инъекций и кликджекинга
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://forms.yandex.ru https://yandex.ru; frame-src https://forms.yandex.ru https://yandex.ru; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://forms.yandex.ru; connect-src 'self' https://forms.yandex.ru; form-action 'self' https://forms.yandex.ru https://yandex.ru; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
  # Страницу нельзя встроить в чужой iframe (защита от кликджекинга)
  Header always set X-Frame-Options "DENY"
  # Браузер не должен угадывать тип содержимого (защита от XSS через подмену MIME)
  Header always set X-Content-Type-Options "nosniff"
  # Referrer утекает минимально — адрес формы/страниц не видны третьим сторонам
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Отключаем доступ к опасным API браузера
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # HSTS: браузер всегда ходит только по HTTPS (90 дней)
  Header always set Strict-Transport-Security "max-age=7776000; includeSubDomains" env=HTTPS
  # Скрываем версию сервера
  Header unset Server
  Header unset X-Powered-By
</IfModule>

# --- 3. Блокировка доступа к служебным файлам ---
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<FilesMatch "\.(env|ini|log|sh|bak|old)$">
  Require all denied
</FilesMatch>

# --- 4. Запрет листинга директорий ---
Options -Indexes

# --- 5. Защита от hotlinking изображений (экономия трафика, защита контента) ---
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_REFERER} !^$
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?%{HTTP_HOST} [NC]
  RewriteRule \.(jpg|jpeg|png|gif|webp)$ - [F,NC,L]
</IfModule>
